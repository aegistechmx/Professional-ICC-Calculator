generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}

enum TemplateCategory {
  TRANSFORMER
  BREAKER
  PANEL
  MOTOR
  LOAD
  OTHER
}

enum SimulationJobType {
  ICC_CALCULATION
  TCC_ANALYSIS
  PDF_REPORT
  OTHER
}

enum SimulationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  passwordHash String // Almacena el hash (bcrypt/argon2), nunca la contraseña plana.
  nombre    String?
  plan      UserPlan @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  proyectos Proyecto[]
}

model Proyecto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  // SUGERENCIA: Para bases de datos que soporten JSON nativo (ej. PostgreSQL), considerar usar `Json` en lugar de `String`.
  // Para SQLite, `String` es la opción correcta para almacenar JSON.
  nodes       String   // Store ReactFlow nodes as JSON string
  edges       String   // Store ReactFlow edges as JSON string
  metadata    String?  // Additional project metadata as JSON string
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  Int?
  template    Template? @relation(fields: [templateId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([templateId])
}

model Template {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  categoria   TemplateCategory @default(OTHER) // substation, panel, industrial, etc.
  // SUGERENCIA: Para bases de datos que soporten JSON nativo (ej. PostgreSQL), considerar usar `Json` en lugar de `String`.
  // Para SQLite, `String` es la opción correcta para almacenar JSON.
  nodes       String   // Template nodes as JSON string
  edges       String   // Template edges as JSON string
  thumbnail   String?  // URL to thumbnail image
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  proyectos   Proyecto[]

  @@index([categoria])
}

model SimulationJob {
  id          Int      @id @default(autoincrement())
  projectId   Int
  type        SimulationJobType @default(ICC_CALCULATION) // icc, tcc, coordination
  status      SimulationJobStatus @default(PENDING) // pending, processing, completed, failed
  // SUGERENCIA: Para bases de datos que soporten JSON nativo (ej. PostgreSQL), considerar usar `Json` en lugar de `String`.
  // Para SQLite, `String` es la opción correcta para almacenar JSON.
  result      String?  // Result as JSON string
  error       String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([projectId])
  @@index([status])
}
